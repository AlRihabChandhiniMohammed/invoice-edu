# Optional. 64-character hex key (32 bytes) used to encrypt the co-founder
# signature at rest with AES-256-GCM. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is not set, a key is generated once at data/signature.key.
SIGNATURE_SECRET=

# Optional. Set automatically when a Vercel Blob store is connected to the
# project. When present, the database and encrypted signature are stored in the
# private Blob store instead of data/ so the app works on Vercel's read-only
# filesystem. Pull it locally with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
